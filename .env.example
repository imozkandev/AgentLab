# AgentForge Environment Configuration

# Provider: mock | openai | anthropic | gemini
AGENTFORGE_PROVIDER=mock

# Optional API Keys (when AGENTFORGE_PROVIDER is not mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database (SQLite for local standalone, PostgreSQL for Docker Compose)
DATABASE_URL=sqlite:///agentforge.db

# Runtime Sandbox (local | docker)
AGENTFORGE_RUNTIME=docker

# Production Deployment (Caddy HTTPS)
DOMAIN=agentforge.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=generate_strong_secret_password_here
POSTGRES_DB=agentforge
