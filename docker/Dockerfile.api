FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git && \
    rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml apps/api/README.md* ./
RUN pip install --no-cache-dir -e .

COPY apps/api/agentforge ./agentforge
COPY skills ./skills
COPY evals ./evals
COPY fixtures ./fixtures

ENV PYTHONPATH=/app
ENV AGENTFORGE_ROOT=/app
ENV DATABASE_URL=postgresql://agentforge:agentforge@postgres:5432/agentforge
ENV AGENTFORGE_RUNTIME=docker

EXPOSE 8000

CMD ["uvicorn", "agentforge.main:app", "--host", "0.0.0.0", "--port", "8000"]
